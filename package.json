{
  "name": "auth-mn-react",
  "version": "0.1.0",
  "description": "Auth.mn нэвтрэлтийн товч — Sign in with Auth.mn (redirect + QR/socket) React component",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.mts", "default": "./dist/index.mjs" },
      "require": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["auth.mn", "login", "sso", "qr", "react", "togtokh.dev"],
  "author": "TOGTOKH.DEV",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/togtokh-dev/auth-mn-react.git"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "dependencies": {
    "react-qr-code": "^2.0.15",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsup": "^8.3.5",
    "typescript": "5.6.3"
  }
}
